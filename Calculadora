.full{grid-column:1/-1}
label{display:block;font-size:.8rem;color:var(--mut);margin-bottom:3px}
input,select,button,textarea{font:inherit;color:var(--tx);background:var(--bg);border:1px solid var(--bd);border-radius:8px;padding:8px 10px;width:100%}
